# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# PyInstaller
*.dist
*.exe
*.app
*.dmg
*.tar.gz
*.zip
vault-runner/

# OS specific
.DS_Store
.Library/

# Android Buildozer
#
# The order of items in this file matters
# ANDROID_API=
# ANDROID_ARCH=
# ANDROID_ROOT=
# ANDROID_SDK_ROOT=
# ANDROID_NDK_ROOT=
#
# command wrapper scripts
# (generated by python -m android)
/toolchain
#
# other gradle-like stuff
/#app/src/main/java/com/yourorg/vaultrunner
/#app/src/main/res
/#app/src/main/AndroidManifest.xml
/#app/jni
/app/src/test

# Gradle files
/build/
/.gradle
/app/.gradle

# Android keystore
*.keystore

# Virtual environments
venv/
env/
ENV/

# Executables
*.exe
*.exe.manifest
*.dll
*.so
*.dylib

# Disk images
*.img
*.raw
*.qcow2

# Vault data (user data - not source)
/Vault/SharedData/**
/Vault/Images/**
/vault-data/

# Sensitive data
*.pem
*.key
*.cert

# Temporary
tmp/
temp/