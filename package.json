{
    "name": "vault-runner",
    "version": "0.1.0",
    "description": "Portable Privacy Vault - Cross-platform launcher for USB workspace",
    "main": "index.js",
    "scripts": {
        "start": "electron .",
        "package": "electron-packager . vault-runner --platform=win32 --arch=x64 --overwrite",
        "package-linux": "electron-packager . vault-runner --platform=linux --arch=x64 --overwrite",
        "package-android": "electron-builder build-overview"
    },
    "keywords": [
        "portable", "usb", "privacy", "sandbox", "virtualization"
    ],
    "author": "Portable Privacy Vault Project",
    "license": "MIT",
    "dependencies": {
        "electron": "^30.0.0",
        "obs-studio-stream-utils": "^0.2.0"
    },
    "publish": {
        "provider": "github"
    }
}